# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modèle et effort de réflexion (low | medium | high)
EXPERT_MODELE=claude-opus-5-5
EXPERT_EFFORT=medium

# Code exigé pour le profil « Équipe commerciale » et les documents internes.
# Laisser vide uniquement pour un usage local ou intranet.
CODE_ACCES_INTERNE=

# Questions autorisées par adresse IP et par heure (0 = illimité)
QUESTIONS_PAR_HEURE=40

# Origines autorisées (séparées par des virgules) si le site est servi ailleurs
CORS_ORIGINS=http://localhost:8000
