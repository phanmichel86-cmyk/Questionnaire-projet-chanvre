PORT=3000

# === Authentication (multi-utilisateur) ===

# Mot de passe legacy : sert (a) à créer le compte "admin" lors de la migration
# d'une ancienne base mono-utilisateur, et (b) comme secret de session par défaut.
# Une fois la migration faite et les comptes créés, ce mot de passe ne sert plus.
APP_PASSWORD=changez-moi

# Code d'invitation à donner aux personnes que vous voulez laisser s'inscrire.
# Si vide → l'inscription est désactivée.
INVITE_CODE=remplacez-par-un-code-aleatoire

# Nom d'utilisateur du compte admin créé lors de la migration (par défaut "admin")
# ADMIN_USERNAME=admin

# Secret HMAC pour signer les cookies de session. Par défaut, dérivé de APP_PASSWORD.
# SESSION_SECRET=

# Durée de la session après login (jours, défaut 365)
# SESSION_TTL_DAYS=365

# === LLM providers ===
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=groq  # ou anthropic
# GROQ_MODEL=llama-3.3-70b-versatile
