# Choisissez UNE des deux options ci-dessous (ou les deux).

# Option 1 (recommandée — GRATUITE) : Groq avec Llama 3.3 70B
# Inscription gratuite sans CB : https://console.groq.com
GROQ_API_KEY=gsk_xxx

# Option 2 (qualité supérieure, payante après 5$ de crédits offerts) : Anthropic Claude
# Inscription : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# Si les deux clés sont définies, Anthropic est utilisé par défaut.
# Pour forcer un fournisseur : LLM_PROVIDER=groq  (ou anthropic)
# LLM_PROVIDER=groq

# Modèle Groq à utiliser (par défaut llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000
